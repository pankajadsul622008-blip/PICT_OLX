# ==============================================================================
# PICT Campus Marketplace - Environment Configuration Template
# Duplicate this file as .env and fill in your actual values
# ==============================================================================

# Administrator Credentials
ADMIN_EMAIL=admin@pict.edu
ADMIN_PASSWORD=admin123

# Sarvam AI Credentials
# Get your API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_VISION_MODEL=gemma4
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration (Supabase PostgreSQL / local SQLite fallback)
DATABASE_URL=postgresql://postgres.your_project:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DATABASE_NAME=listings.db

# Cloudinary Image Storage & CDN
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Campus & WhatsApp Regional Settings
COLLEGE_NAME=PICT
COLLEGE_FULL_NAME=Pune Institute of Computer Technology
UNIVERSITY_NAME=SPPU
WHATSAPP_DEFAULT_COUNTRY_CODE=91
DEFAULT_CURRENCY=INR
